# ---- Shared with the website (use the SAME values) ----
# MongoDB Atlas link — same database as the website (…mongodb.net/inmedica?…)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/inmedica?retryWrites=true&w=majority
# Shared secret the admin uses to tell the website to refresh after a save.
# Any long random string; put the SAME value in the website's settings.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---- Admin only ----
# Public address of the live website (used for previews and refresh calls)
WEBSITE_URL=https://www.inmedicadevices.com
# Public address of this admin portal (used in password-reset links)
ADMIN_URL=https://admin.inmedicadevices.com
# Secret used to sign login sessions. Any long random string (keep private).
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string
# One-time code needed to create the first Super Admin at /setup.
ADMIN_SETUP_TOKEN=change-me
# Email allowed to become the first Super Admin
ADMIN_BOOTSTRAP_EMAIL=inmedicadevices@gmail.com

# Email (for password-reset emails) — same Gmail settings as the website
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inmedicadevices@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
MAIL_FROM="InMedica Admin <inmedicadevices@gmail.com>"
